{
  "expo": {
    "name": "gardirop",
    "slug": "gardirop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gardirop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F3EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gardirop.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Gardırop, kıyafetlerinizin fotoğrafını çekip yapay zeka ile otomatik olarak tanımlayabilmesi için kameraya erişir.",
        "NSPhotoLibraryUsageDescription": "Gardırop, gardırobunuza eklemek istediğiniz kıyafet fotoğraflarını seçebilmeniz için fotoğraflarınıza erişir."
      }
    },
    "android": {
      "package": "com.gardirop.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "13e3b561-bec7-40d3-90b9-27d56179c333"
      }
    }
  }
}
