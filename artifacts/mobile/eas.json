{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "PNPM_CONFIG_NODE_LINKER": "hoisted",
        "EXPO_ROUTER_APP_ROOT": "./app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
